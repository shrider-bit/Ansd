{
  "name": "grannys-house",
  "private": true,
  "version": "0.1.0",
  "description": "GRANNY'S HOUSE: AHMED vs MIRAL - a kid-friendly first-person horror game",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:server": "npm run build:server && node dist-server/server.mjs",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/server.mjs --packages=external",
    "start": "node dist-server/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "three": "0.180.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/cli": "7.6.10",
    "@capacitor/core": "7.6.10",
    "@types/node": "^22.20.5",
    "@types/three": "0.180.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
